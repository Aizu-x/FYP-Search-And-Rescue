{
  "version": "0.2.0",
  "configurations": [
    {"name": "UGV interactive simulator", "type": "debugpy", "request": "launch", "program": "${workspaceFolder}/main.py", "console": "integratedTerminal"},
    {"name": "All environments (headless)", "type": "debugpy", "request": "launch", "program": "${workspaceFolder}/main.py", "args": ["--batch"], "console": "integratedTerminal"},
    {"name": "NAV: operator console v2 (planner / simulator / robot)", "type": "debugpy", "request": "launch", "program": "${workspaceFolder}/nav_main.py", "args": ["gui"], "console": "integratedTerminal", "cwd": "${workspaceFolder}"},
    {"name": "NAV: closed-loop sim demo ENV1 (no window)", "type": "debugpy", "request": "launch", "program": "${workspaceFolder}/nav_main.py", "args": ["sim-demo", "--env", "ENV1", "--recalibrate"], "console": "integratedTerminal", "cwd": "${workspaceFolder}"},
    {"name": "NAV: run all tests", "type": "debugpy", "request": "launch", "module": "unittest", "args": ["discover", "-s", "tests", "-v"], "console": "integratedTerminal", "cwd": "${workspaceFolder}"},
    {"name": "NAV: check connection to MentorPi (no motion)", "type": "debugpy", "request": "launch", "program": "${workspaceFolder}/nav_main.py", "args": ["check-connection", "--host", "${input:piHost}"], "console": "integratedTerminal", "cwd": "${workspaceFolder}"}
  ],
  "inputs": [
    {"id": "piHost", "type": "promptString", "description": "MentorPi IP address"}
  ]
}
